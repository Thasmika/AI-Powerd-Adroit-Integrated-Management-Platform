# Database configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password
POSTGRES_DB=adroit_db

# Security
# Generate a secure key for production using: openssl rand -hex 32
SECRET_KEY=supersecretkey_change_this_in_production

# CORS
# e.g., ["http://app.adroit.ae", "https://app.adroit.ae"]
BACKEND_CORS_ORIGINS=["http://localhost", "http://localhost:3000"]

# AI Integration
GROQ_API_KEY=your_groq_api_key

# Frontend API URL
# In prod, this should point to your domain's /api/v1 (e.g. https://app.adroit.ae/api/v1)
NEXT_PUBLIC_API_URL=http://localhost/api/v1
